# Copy this file to .env.local for local development.
# On Vercel, add the same names under Project → Settings → Environment Variables.

# Supabase (sign in / sign up). From Supabase → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Who can open /admin. Comma-separated emails.
ADMIN_EMAILS=

# Luma (live guest counts). From Luma → Calendar → Settings → API keys (needs Luma Plus).
LUMA_API_KEY=
